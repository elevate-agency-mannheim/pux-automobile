---
import Icons from "./Icons.astro";

const DIENSTLEISTUNGEN = [
  { value: "aufbereitung", label: "Autoaufbereitung", desc: "Mobile Fahrzeugaufbereitung direkt bei Ihnen vor Ort.", anliegen: "Aufbereitung" },
  { value: "ankauf", label: "Fahrzeug verkaufen", desc: "Sie möchten Ihr Auto an uns verkaufen – schnelle, faire Bewertung.", anliegen: "Fahrzeug verkaufen" },
  { value: "verkauf", label: "Fahrzeug kaufen", desc: "Sie suchen ein Fahrzeug aus unserem Bestand.", anliegen: "Fahrzeug kaufen" },
];

interface Paket {
  value: string;
  name: string;
  price: number;
  bestseller?: boolean;
  combo?: string;
  leistung: string;
  features: string[];
  includesZusatz?: string[];
}

const INNENRAUM_PAKETE: Paket[] = [
  {
    value: "Innenraum Basic – 100 €",
    name: "Basic",
    price: 100,
    leistung: "Innenreinigung",
    features: [
      "Müll entfernen",
      "Innenraum & Kofferraum saugen",
      "Fußräume wischen",
      "Türverkleidungen & Kunststoffflächen wischen",
      "Scheiben innen reinigen",
    ],
  },
  {
    value: "Innenraum Komfort – 150 €",
    name: "Komfort",
    price: 150,
    bestseller: true,
    leistung: "Innenreinigung",
    combo: "Enthält Basic +",
    features: [
      "Druckluftreinigung schwer erreichbarer Stellen",
      "Intensive Reinigung von Schaltern, Lüftungen etc.",
      "Pflege aller Kunststoff-, Leder- & Gummiflächen",
      "Mittelkonsole & Bedienelemente reinigen",
      "Lenkrad & Cockpit reinigen",
      "Fußmatten reinigen & pflegen",
      "Polster-/Leder-Tiefenreinigung inkl. Pflege",
      "Detailreinigung aller Sitzkanten",
      "Reinigung & Pflege aller Ablagen und Einlageteile",
    ],
  },
  {
    value: "Innenraum Premium – 230 €",
    name: "Premium",
    price: 230,
    leistung: "Innenreinigung",
    combo: "Enthält Komfort +",
    features: [
      "Kunststoffversiegelung im Innenraum",
      "Lederversiegelung",
      "Klimaanlagen-Desinfektion",
      "Ozonbehandlung",
    ],
    includesZusatz: ["lederversiegelung"],
  },
];

const AUSSEN_PAKETE: Paket[] = [
  {
    value: "Außen Premium – 100 €",
    name: "Außen Premium",
    price: 100,
    leistung: "Außenreinigung",
    features: [
      "Felgenreinigung inkl. Radkästen",
      "Reifenreinigung & Reifenglanz",
      "Vorwäsche mit Snow Foam",
      "Insektenentfernung",
      "Handwäsche",
      "Türholme & Einstiege reinigen",
      "Detailreinigung von Emblemen & Zierleisten",
      "Scheiben innen & außen reinigen",
      "Handtrocknung mit Mikrofasertüchern",
      "Pflege der Außenkunststoffe (bei Bedarf)",
    ],
  },
];

const BUNDLE_PAKETE: Paket[] = [
  {
    value: "PUX-Bundle – 240 €",
    name: "PUX-Bundle",
    price: 240,
    leistung: "Komplettpaket",
    features: [
      "Innenraum Komfort Paket",
      "Außen Premium Paket",
      "Kostenlose Sprühversiegelung im Wert von 50 € (UV-Schutz, weniger Schmutzanhaftung, intensiver Glanz, starker Wasser-Abperleffekt)",
    ],
    includesZusatz: ["spruehversiegelung"],
  },
];

const FAHRZEUGGROESSEN = [
  { value: "Kleinwagen", examples: "Polo, Corsa, etc." },
  { value: "Standard", examples: "Golf, 3er BMW, etc." },
  { value: "SUV", examples: "Tiguan, X3, etc.", full: true },
];

const ZUSATZLEISTUNGEN = [
  { id: "verschmutzung-stark", value: "Starke Verschmutzung (30 €)", label: "Starke Verschmutzung", price: 30 },
  { id: "verschmutzung-extrem", value: "Extreme Verschmutzung (70 €)", label: "Extreme Verschmutzung", price: 70 },
  { id: "tierhaare-stark", value: "Starke Tierhaarentfernung (40 €)", label: "Starke Tierhaarentfernung", price: 40 },
  { id: "spruehversiegelung", value: "Sprühversiegelung außen (50 €)", label: "Sprühversiegelung außen", price: 50 },
  { id: "lederversiegelung", value: "Lederversiegelung (50 €)", label: "Lederversiegelung", price: 50 },
  { id: "motorwaesche", value: "Motorwäsche (49 €)", label: "Motorwäsche", price: 49 },
];
---

<div id="wizard-progress" class="mb-6">
  <div class="flex items-center justify-between mb-2">
    <span id="wizard-step-label" class="text-sm font-semibold text-[#1B2B6B]">Schritt 1 von 5</span>
    <span id="wizard-step-name" class="text-sm text-gray-400">Dienstleistung</span>
  </div>
  <div class="h-2 rounded-full bg-gray-100 overflow-hidden">
    <div id="wizard-progress-bar" class="h-full rounded-full transition-all duration-500" style="width:20%; background: var(--pux-gradient);"></div>
  </div>
</div>

<div class="bg-white rounded-3xl border border-gray-100 shadow-xl p-8 md:p-12">
  <form id="contact-form" novalidate>
    <input type="hidden" id="selected-tab" name="anliegen" value="Aufbereitung" />
    <input type="hidden" id="leistung-field" name="leistung" value="" />
    <input type="hidden" id="quelle-field" name="quelle" value="" />

    <!-- General error banner -->
    <div id="form-general-error" class="hidden mb-6 flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 p-4">
      <svg class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" />
      </svg>
      <p id="form-general-error-text" class="text-sm text-red-700 leading-relaxed">Es ist ein Fehler aufgetreten.</p>
    </div>

    <!-- STEP: Dienstleistung -->
    <div class="wizard-step" data-step-id="dienstleistung">
      <label class="block text-sm font-medium text-gray-700 mb-2.5">Was möchten Sie anfragen? *</label>
      <div class="space-y-3">
        {DIENSTLEISTUNGEN.map((d) => (
          <label class="has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] relative flex items-start gap-3 border-2 border-gray-200 rounded-xl px-4 py-3.5 cursor-pointer transition-all">
            <input type="radio" name="dienstleistung" value={d.value} data-anliegen={d.anliegen} class="peer sr-only" />
            <span class="w-5 h-5 rounded-full border-2 border-gray-300 peer-checked:border-[#3A7BD5] flex items-center justify-center flex-shrink-0 transition-colors mt-0.5">
              <span class="w-2.5 h-2.5 rounded-full bg-[#3A7BD5] scale-0 peer-checked:scale-100 transition-transform"></span>
            </span>
            <span>
              <span class="block text-sm font-semibold text-gray-800">{d.label}</span>
              <span class="block text-xs text-gray-500 mt-0.5">{d.desc}</span>
            </span>
          </label>
        ))}
      </div>
      <p id="error-dienstleistung" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      <button type="button" class="wizard-next-btn group mt-6 w-full sm:w-auto inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
        <span class="wizard-next-btn-text">Weiter</span>
        <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
      </button>
    </div>

    <!-- STEP (aufbereitung): Paket -->
    <div class="wizard-step hidden" data-step-id="paket" data-path="aufbereitung">
      <label class="block text-sm font-medium text-gray-700 mb-2.5">Paket auswählen *</label>

      <!-- Sub-tabs: Innenreinigung / Außenreinigung / Komplettpaket -->
      <div class="flex flex-col sm:flex-row gap-3 mb-6 p-1.5 bg-gray-50 rounded-2xl">
        <button type="button" class="paket-tab-btn tab-btn active flex-1 py-3 px-4 rounded-xl font-semibold text-sm text-gray-600" data-paket-tab="Innenreinigung" aria-selected="true">
          Innenreinigung
        </button>
        <button type="button" class="paket-tab-btn tab-btn flex-1 py-3 px-4 rounded-xl font-semibold text-sm text-gray-600" data-paket-tab="Außenreinigung" aria-selected="false">
          Außenreinigung
        </button>
        <button type="button" class="paket-tab-btn tab-btn flex-1 py-3 px-4 rounded-xl font-semibold text-sm text-gray-600 border-2 border-amber-300" data-paket-tab="Komplettpaket" aria-selected="false">
          <span class="inline-flex items-center gap-1.5">
            <Icons name="star" class="w-3.5 h-3.5 text-amber-500" />
            Komplettpaket
          </span>
        </button>
      </div>

      <div class="paket-group space-y-4" data-for="Innenreinigung">
        {INNENRAUM_PAKETE.map((p) => (
          <label class={`has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] relative block border-2 ${p.bestseller ? "border-amber-300" : "border-gray-200"} rounded-2xl px-5 py-4 cursor-pointer transition-all`}>
            <input type="radio" name="paket" value={p.value} data-leistung={p.leistung} data-includes={(p.includesZusatz ?? []).join(",")} data-price={p.price} class="peer sr-only" />
            {p.bestseller && (
              <span class="inline-flex items-center gap-1 bg-amber-400 text-gray-900 text-[11px] font-bold px-2.5 py-1 rounded-full mb-2">
                <Icons name="star" class="w-3 h-3" /> BESTSELLER
              </span>
            )}
            <div class="flex items-center justify-between gap-3 mb-1">
              <span class="font-bold text-gray-900">{p.name}</span>
              <span class="font-extrabold text-[#1B2B6B]">ab {p.price} €</span>
            </div>
            {p.combo && <p class="text-xs font-semibold mb-2" style="color:#3A7BD5;">{p.combo}</p>}
            <ul class="space-y-1 mt-2">
              {p.features.map((f) => (
                <li class="flex items-start gap-2 text-xs text-gray-600">
                  <Icons name="check-circle" class="w-3.5 h-3.5 text-[#3A7BD5] mt-0.5 flex-shrink-0" />
                  {f}
                </li>
              ))}
            </ul>
          </label>
        ))}
      </div>

      <div class="paket-group hidden space-y-4" data-for="Außenreinigung">
        {AUSSEN_PAKETE.map((p) => (
          <label class="has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] relative block border-2 border-gray-200 rounded-2xl px-5 py-4 cursor-pointer transition-all">
            <input type="radio" name="paket" value={p.value} data-leistung={p.leistung} data-includes={(p.includesZusatz ?? []).join(",")} data-price={p.price} class="peer sr-only" />
            <div class="flex items-center justify-between gap-3 mb-1">
              <span class="font-bold text-gray-900">{p.name}</span>
              <span class="font-extrabold text-[#1B2B6B]">ab {p.price} €</span>
            </div>
            <ul class="space-y-1 mt-2">
              {p.features.map((f) => (
                <li class="flex items-start gap-2 text-xs text-gray-600">
                  <Icons name="check-circle" class="w-3.5 h-3.5 text-[#3A7BD5] mt-0.5 flex-shrink-0" />
                  {f}
                </li>
              ))}
            </ul>
          </label>
        ))}
      </div>

      <div class="paket-group hidden space-y-4" data-for="Komplettpaket">
        {BUNDLE_PAKETE.map((p) => (
          <label class="has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] relative block border-2 border-amber-300 rounded-2xl px-5 py-4 cursor-pointer transition-all">
            <input type="radio" name="paket" value={p.value} data-leistung={p.leistung} data-includes={(p.includesZusatz ?? []).join(",")} data-price={p.price} class="peer sr-only" />
            <span class="inline-flex items-center gap-1 bg-amber-400 text-gray-900 text-[11px] font-bold px-2.5 py-1 rounded-full mb-2">
              <Icons name="star" class="w-3 h-3" /> BESTER WERT
            </span>
            <div class="flex items-center justify-between gap-3 mb-1">
              <span class="font-bold text-gray-900">{p.name}</span>
              <span class="font-extrabold text-[#1B2B6B]">ab {p.price} €</span>
            </div>
            <ul class="space-y-1 mt-2">
              {p.features.map((f) => (
                <li class="flex items-start gap-2 text-xs text-gray-600">
                  <Icons name="check-circle" class="w-3.5 h-3.5 text-[#3A7BD5] mt-0.5 flex-shrink-0" />
                  {f}
                </li>
              ))}
            </ul>
          </label>
        ))}
      </div>

      <p id="error-paket" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="paket" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Weiter</span>
          <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </button>
      </div>
    </div>

    <!-- STEP (aufbereitung): Fahrzeuggröße -->
    <div class="wizard-step hidden" data-step-id="fahrzeuggroesse" data-path="aufbereitung">
      <label class="block text-sm font-medium text-gray-700 mb-2.5">Fahrzeuggröße <span class="font-normal text-gray-400">(optional)</span></label>
      <div class="grid grid-cols-2 gap-4">
        {FAHRZEUGGROESSEN.map((g) => (
          <label class={`has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] flex flex-col items-center justify-center text-center border border-gray-200 rounded-2xl px-4 py-6 cursor-pointer transition-all ${g.full ? "col-span-2" : ""}`}>
            <input type="radio" name="fahrzeuggroesse" value={g.value} class="sr-only" />
            <span class="font-semibold text-gray-900">{g.value}</span>
            <span class="text-sm text-gray-400 mt-1">{g.examples}</span>
          </label>
        ))}
      </div>
      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="fahrzeuggroesse" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Weiter</span>
          <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </button>
      </div>
    </div>

    <!-- STEP (aufbereitung): Zusatzleistungen -->
    <div class="wizard-step hidden" data-step-id="zusatzleistungen" data-path="aufbereitung">
      <label class="block text-sm font-medium text-gray-700 mb-2.5">Zusatzleistungen <span class="font-normal text-gray-400">(optional)</span></label>
      <div class="space-y-2.5">
        {ZUSATZLEISTUNGEN.map((z) => (
          <label data-zusatz-id={z.id} class="has-[:checked]:border-[#3A7BD5] has-[:checked]:bg-[#EEF3FB] flex items-center justify-between gap-3 border-2 border-gray-200 rounded-xl px-4 py-3 cursor-pointer transition-all">
            <span class="flex items-center gap-3">
              <input type="checkbox" name="zusatzleistung" value={z.value} data-price={z.price} class="w-4 h-4 rounded border-gray-300 accent-[#3A7BD5] flex-shrink-0" />
              <span class="text-sm font-medium text-gray-700">{z.label}</span>
            </span>
            <span class="text-sm font-semibold text-gray-400">ab {z.price} €</span>
          </label>
        ))}
      </div>
      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="zusatzleistungen" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Weiter</span>
          <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </button>
      </div>
    </div>

    <!-- STEP (ankauf): Fahrzeugdaten -->
    <div class="wizard-step hidden" data-step-id="ankauf-felder" data-path="ankauf">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="fahrzeug-ank" class="block text-sm font-medium text-gray-700 mb-1.5">Fahrzeug (Marke & Modell) *</label>
          <input type="text" id="fahrzeug-ank" name="fahrzeug_ankauf" placeholder="z. B. BMW 3er"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
          <p id="error-fahrzeug_ankauf" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
        </div>
        <div>
          <label for="baujahr-ank" class="block text-sm font-medium text-gray-700 mb-1.5">Baujahr</label>
          <input type="number" id="baujahr-ank" name="baujahr_ankauf" placeholder="2019" min="1990" max="2026"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mt-5">
        <div>
          <label for="km-ank" class="block text-sm font-medium text-gray-700 mb-1.5">Kilometerstand</label>
          <input type="number" id="km-ank" name="km_ankauf" placeholder="85000"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        </div>
        <div>
          <label for="zustand-ank" class="block text-sm font-medium text-gray-700 mb-1.5">Zustand</label>
          <select id="zustand-ank" name="zustand_ankauf"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm bg-white">
            <option value="">Bitte wählen...</option>
            <option>Sehr gut (wie neu)</option>
            <option>Gut (normale Gebrauchsspuren)</option>
            <option>Gebraucht (sichtbare Mängel)</option>
            <option>Beschädigt / Unfall</option>
          </select>
        </div>
      </div>
      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="ankauf-felder" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Weiter</span>
          <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </button>
      </div>
    </div>

    <!-- STEP (verkauf): Wunschfahrzeug -->
    <div class="wizard-step hidden" data-step-id="verkauf-felder" data-path="verkauf">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        <div>
          <label for="wunsch-fzg" class="block text-sm font-medium text-gray-700 mb-1.5">Gewünschtes Fahrzeug</label>
          <input type="text" id="wunsch-fzg" name="wunsch_fahrzeug" placeholder="z. B. Mercedes C-Klasse, Benzin"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        </div>
        <div>
          <label for="budget" class="block text-sm font-medium text-gray-700 mb-1.5">Budget (ca.)</label>
          <input type="text" id="budget" name="budget" placeholder="z. B. 15.000 €"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        </div>
      </div>
      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="verkauf-felder" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Weiter</span>
          <Icons name="arrow-right" class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
        </button>
      </div>
    </div>

    <!-- FINAL STEP (all paths): Kontaktdaten -->
    <div class="wizard-step hidden" data-step-id="kontaktdaten">
      <label class="block text-sm font-medium text-gray-700 mb-2.5">Ihre Kontaktdaten</label>

      <div id="plz-field" class="mb-5">
        <label for="plz" class="block text-sm font-medium text-gray-700 mb-1.5">PLZ *</label>
        <input type="text" id="plz" name="plz" inputmode="numeric" maxlength="5" placeholder="z. B. 68159"
          class="w-full sm:w-48 border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        <p id="error-plz" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      </div>

      <div id="voraussetzung-strom" class="hidden mb-5">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="check-steckdose" name="steckdose_verfuegbar" value="Ja" class="mt-0.5 w-4 h-4 rounded border-gray-300 accent-[#3A7BD5] flex-shrink-0" />
          <span class="text-sm text-gray-600">Eine Steckdose ist vor Ort verfügbar. *</span>
        </label>
        <p id="error-steckdose_verfuegbar" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      </div>

      <div id="voraussetzung-wasser" class="hidden mb-5">
        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" id="check-wasseranschluss" name="wasseranschluss_verfuegbar" value="Ja" class="mt-0.5 w-4 h-4 rounded border-gray-300 accent-[#3A7BD5] flex-shrink-0" />
          <span class="text-sm text-gray-600">Ein Wasseranschluss (z. B. Gartenschlauch) ist vor Ort verfügbar. *</span>
        </label>
        <p id="error-wasseranschluss_verfuegbar" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for="name" class="block text-sm font-medium text-gray-700 mb-1.5">Name *</label>
          <input type="text" id="name" name="name" placeholder="Max Mustermann"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
          <p id="error-name" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
        </div>
        <div>
          <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Telefon *</label>
          <input type="tel" id="phone" name="telefon" placeholder="+49 621 XXXXXXX"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
          <p id="error-telefon" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
        </div>
      </div>

      <div class="mb-5">
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">E-Mail <span class="font-normal text-gray-400">(optional)</span></label>
        <input type="email" id="email" name="email" placeholder="max@beispiel.de"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        <p id="error-email" class="field-error hidden text-xs text-red-600 mt-1.5 font-medium"></p>
      </div>

      <div class="mb-5">
        <label for="message" class="block text-sm font-medium text-gray-700 mb-1.5">Nachricht / Anmerkungen</label>
        <textarea id="message" name="nachricht" rows="3" placeholder="Weitere Infos zu Ihrem Anliegen..."
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm resize-none"></textarea>
      </div>

      <div class="flex items-start gap-3 rounded-2xl bg-[#EEF3FB] p-5">
        <Icons name="check-circle" class="w-5 h-5 text-[#3A7BD5] flex-shrink-0 mt-0.5" />
        <p class="text-sm text-gray-600 leading-relaxed">
          Die Anfrage ist unverbindlich. Wir melden uns so schnell es geht und stimmen uns zu Fragen und zu einem passenden Termin ab.
        </p>
      </div>

      <div class="flex gap-3 mt-6">
        <button type="button" data-wizard-back="kontaktdaten" class="inline-flex items-center justify-center gap-2 py-3 px-5 rounded-xl text-sm font-semibold text-[#1B2B6B] border-2 border-[#1B2B6B]/20 hover:border-[#1B2B6B] hover:bg-[#EEF3FB] transition-all duration-200">
          Zurück
        </button>
        <button type="button" class="wizard-next-btn group flex-1 inline-flex items-center justify-center gap-2 py-3 px-6 rounded-xl text-sm font-semibold btn-primary">
          <span class="wizard-next-btn-text">Anfrage absenden →</span>
        </button>
      </div>

      <p class="text-xs text-gray-400 text-center mt-4">
        Keine Weitergabe Ihrer Daten an Dritte.
      </p>
    </div>
  </form>

  <!-- Success state -->
  <div id="form-success" class="hidden text-center py-12 px-6 rounded-2xl bg-green-50 border border-green-200">
    <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-5">
      <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h3 class="text-2xl font-bold text-gray-900 mb-3">Anfrage erhalten!</h3>
    <p id="form-success-text" class="text-gray-600 text-base max-w-sm mx-auto">
      Vielen Dank! Wir haben deine Anfrage erhalten und melden uns so schnell wie möglich bei dir.
    </p>
  </div>
</div>

<div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 mt-6 text-sm text-gray-600">
  {["SSL gesichert", "Keine Vorauszahlung", "Kostenlose Beratung"].map((item) => (
    <span class="flex items-center gap-1.5">
      <Icons name="check-circle" class="w-4 h-4 text-emerald-500 flex-shrink-0" />
      {item}
    </span>
  ))}
</div>

<!-- Spacer so the fixed sticky bar never covers page content -->
<div class="h-24" aria-hidden="true"></div>

<div id="sticky-bar" class="fixed bottom-0 left-0 right-0 z-40 bg-white border-t border-gray-200 shadow-[0_-4px_20px_rgba(0,0,0,0.08)]">
  <div class="max-w-3xl mx-auto px-6 py-4 flex items-center justify-between gap-4">
    <div id="sticky-price-wrap" class="hidden leading-tight">
      <span class="block text-xs text-gray-400">Gesamtpreis</span>
      <span id="sticky-price-value" class="block text-xl sm:text-2xl font-extrabold text-gray-900">–</span>
    </div>
    <div class="flex-1"></div>
    <button type="button" id="sticky-next-btn" class="wizard-next-btn btn-primary px-6 sm:px-8 py-3.5 text-sm font-semibold disabled:opacity-40 disabled:cursor-not-allowed disabled:pointer-events-none">
      <span id="sticky-next-text" class="wizard-next-btn-text">Weiter</span>
    </button>
  </div>
</div>

<script>
  const STEP_SEQUENCES: Record<string, string[]> = {
    aufbereitung: ["dienstleistung", "paket", "fahrzeuggroesse", "zusatzleistungen", "kontaktdaten"],
    ankauf: ["dienstleistung", "ankauf-felder", "kontaktdaten"],
    verkauf: ["dienstleistung", "verkauf-felder", "kontaktdaten"],
  };
  const STEP_LABELS: Record<string, string> = {
    dienstleistung: "Dienstleistung",
    paket: "Paket",
    fahrzeuggroesse: "Fahrzeuggröße",
    zusatzleistungen: "Zusatzleistungen",
    "ankauf-felder": "Fahrzeugdaten",
    "verkauf-felder": "Wunschfahrzeug",
    kontaktdaten: "Kontaktdaten",
  };

  const selectedTab = document.getElementById("selected-tab") as HTMLInputElement;
  const leistungField = document.getElementById("leistung-field") as HTMLInputElement;
  const wizardProgress = document.getElementById("wizard-progress") as HTMLElement;
  const wizardStepLabel = document.getElementById("wizard-step-label") as HTMLElement;
  const wizardStepName = document.getElementById("wizard-step-name") as HTMLElement;
  const wizardProgressBar = document.getElementById("wizard-progress-bar") as HTMLElement;
  const plzField = document.getElementById("plz-field") as HTMLElement;
  const stickyBar = document.getElementById("sticky-bar") as HTMLElement;
  // The wrapping ".reveal" element on the /kontakt page (kontakt.astro) applies a
  // transform/filter transition that never fully resets to the literal "none" value
  // (translateY(0) / blur(0)), which per spec makes it a containing block for any
  // position:fixed descendant. That traps the bar at the bottom of that wrapper
  // instead of the real viewport edge, so we move it out to a direct child of
  // <body> at runtime, where no ancestor sets transform/filter.
  document.body.appendChild(stickyBar);
  const stickyPriceWrap = document.getElementById("sticky-price-wrap") as HTMLElement;
  const stickyPriceValue = document.getElementById("sticky-price-value") as HTMLElement;
  const stickyNextBtn = document.getElementById("sticky-next-btn") as HTMLButtonElement;
  const stickyNextText = document.getElementById("sticky-next-text") as HTMLElement;
  // Every step has its own inline "Weiter"/"Anfrage absenden" button next to "Zurück",
  // plus the persistent sticky one — all share this class and stay in sync.
  const nextBtns = document.querySelectorAll<HTMLButtonElement>(".wizard-next-btn");
  const voraussetzungStrom = document.getElementById("voraussetzung-strom") as HTMLElement;
  const voraussetzungWasser = document.getElementById("voraussetzung-wasser") as HTMLElement;
  const checkSteckdose = document.getElementById("check-steckdose") as HTMLInputElement;
  const checkWasseranschluss = document.getElementById("check-wasseranschluss") as HTMLInputElement;

  let currentPath = "aufbereitung";
  let currentIndex = 0;

  function render() {
    const sequence = STEP_SEQUENCES[currentPath];
    const stepId = sequence[currentIndex];

    document.querySelectorAll<HTMLElement>(".wizard-step").forEach((el) => {
      el.classList.toggle("hidden", el.dataset.stepId !== stepId);
    });

    plzField.classList.toggle("hidden", currentPath !== "aufbereitung");
    document.getElementById("plz")!.toggleAttribute("required", currentPath === "aufbereitung");

    wizardStepLabel.textContent = `Schritt ${currentIndex + 1} von ${sequence.length}`;
    wizardStepName.textContent = STEP_LABELS[stepId] ?? "";
    wizardProgressBar.style.width = `${((currentIndex + 1) / sequence.length) * 100}%`;

    updateStickyBar();
  }

  // Innenreinigung needs a power socket, Außenreinigung needs a water hookup,
  // Komplettpaket (Bundle) needs both — shown/required only on the final step.
  function getVoraussetzungState() {
    const leistung = leistungField.value;
    return {
      showStrom: leistung === "Innenreinigung" || leistung === "Komplettpaket",
      showWasser: leistung === "Außenreinigung" || leistung === "Komplettpaket",
    };
  }

  function updateVoraussetzungen() {
    const { showStrom, showWasser } = getVoraussetzungState();
    voraussetzungStrom.classList.toggle("hidden", !showStrom);
    voraussetzungWasser.classList.toggle("hidden", !showWasser);
    checkSteckdose.required = showStrom;
    checkWasseranschluss.required = showWasser;
    if (!showStrom) checkSteckdose.checked = false;
    if (!showWasser) checkWasseranschluss.checked = false;
  }

  function canAdvance(): boolean {
    const stepId = STEP_SEQUENCES[currentPath][currentIndex];
    if (stepId === "dienstleistung") return !!document.querySelector('input[name="dienstleistung"]:checked');
    if (stepId === "paket") return !!document.querySelector('input[name="paket"]:checked');
    if (stepId === "ankauf-felder") return !!(document.getElementById("fahrzeug-ank") as HTMLInputElement).value.trim();
    if (stepId === "kontaktdaten") {
      const name = (document.getElementById("name") as HTMLInputElement).value.trim();
      const telefon = (document.getElementById("phone") as HTMLInputElement).value.trim();
      if (!name || !telefon) return false;
      if (currentPath === "aufbereitung") {
        const plz = (document.getElementById("plz") as HTMLInputElement).value.trim();
        if (!/^\d{5}$/.test(plz)) return false;
        const { showStrom, showWasser } = getVoraussetzungState();
        if (showStrom && !checkSteckdose.checked) return false;
        if (showWasser && !checkWasseranschluss.checked) return false;
      }
      return true;
    }
    return true;
  }

  function updateStickyBar() {
    const sequence = STEP_SEQUENCES[currentPath];
    const stepId = sequence[currentIndex];

    const label = stepId === "kontaktdaten" ? "Anfrage absenden →" : "Weiter";
    const disabled = !canAdvance();
    nextBtns.forEach((btn) => {
      btn.disabled = disabled;
      const textEl = btn.querySelector<HTMLElement>(".wizard-next-btn-text");
      if (textEl) textEl.textContent = label;
    });

    if (currentPath === "aufbereitung") {
      stickyPriceWrap.classList.remove("hidden");
      const paketRadio = document.querySelector<HTMLInputElement>('input[name="paket"]:checked');
      if (paketRadio) {
        const paketPrice = Number(paketRadio.dataset.price || 0);
        const extrasTotal = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="zusatzleistung"]:checked'))
          .reduce((sum, cb) => sum + Number(cb.dataset.price || 0), 0);
        stickyPriceValue.textContent = `ab ${paketPrice + extrasTotal} €`;
      } else {
        stickyPriceValue.textContent = "–";
      }
    } else {
      stickyPriceWrap.classList.add("hidden");
    }
  }

  function goToIndex(index: number) {
    currentIndex = index;
    render();
    window.scrollTo({ top: 0, behavior: "smooth" });
  }

  function setPath(path: string, skipFirstStep: boolean) {
    currentPath = path;
    currentIndex = skipFirstStep ? 1 : 0;
    render();
  }

  document.querySelectorAll<HTMLInputElement>('input[name="dienstleistung"]').forEach((radio) => {
    radio.addEventListener("change", () => {
      selectedTab.value = radio.dataset.anliegen ?? "Aufbereitung";
      updateStickyBar();
    });
  });

  // Sub-tabs inside the "Paket" step: Innenreinigung / Außenreinigung / Komplettpaket
  const paketTabBtns = document.querySelectorAll<HTMLButtonElement>(".paket-tab-btn");
  function showPaketGroupFor(leistungValue: string) {
    paketTabBtns.forEach((b) => {
      const match = b.dataset.paketTab === leistungValue;
      b.classList.toggle("active", match);
      b.setAttribute("aria-selected", String(match));
    });
    document.querySelectorAll<HTMLElement>(".paket-group").forEach((g) => {
      g.classList.toggle("hidden", g.dataset.for !== leistungValue);
    });
  }
  paketTabBtns.forEach((btn) => {
    btn.addEventListener("click", () => showPaketGroupFor(btn.dataset.paketTab!));
  });

  function updateZusatzleistungenAvailability() {
    const checkedPaket = document.querySelector<HTMLInputElement>('input[name="paket"]:checked');
    const included = (checkedPaket?.dataset.includes ?? "").split(",").filter(Boolean);
    document.querySelectorAll<HTMLElement>("[data-zusatz-id]").forEach((item) => {
      const alreadyIncluded = included.includes(item.dataset.zusatzId ?? "");
      item.classList.toggle("hidden", alreadyIncluded);
      if (alreadyIncluded) {
        const checkbox = item.querySelector<HTMLInputElement>('input[type="checkbox"]');
        if (checkbox) checkbox.checked = false;
      }
    });
  }
  document.querySelectorAll<HTMLInputElement>('input[name="paket"]').forEach((r) =>
    r.addEventListener("change", () => {
      leistungField.value = r.dataset.leistung ?? "";
      updateZusatzleistungenAvailability();
      updateVoraussetzungen();
      updateStickyBar();
    })
  );
  document.querySelectorAll<HTMLInputElement>('input[name="zusatzleistung"]').forEach((cb) =>
    cb.addEventListener("change", updateStickyBar)
  );
  [checkSteckdose, checkWasseranschluss].forEach((cb) => cb.addEventListener("change", updateStickyBar));
  ["fahrzeug-ank", "name", "phone", "plz"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", updateStickyBar);
  });

  // Wizard navigation — the sticky bottom bar drives "Weiter" for every step,
  // and becomes the actual submit trigger on the final "Kontaktdaten" step.
  function attemptAdvance() {
    const stepId = STEP_SEQUENCES[currentPath][currentIndex];
    clearErrors();

    if (stepId === "dienstleistung") {
      const checked = document.querySelector<HTMLInputElement>('input[name="dienstleistung"]:checked');
      if (!checked) { showFieldError("dienstleistung", "Bitte wähle eine Option aus."); return; }
      setPath(checked.value, false);
      goToIndex(1);
      return;
    }
    if (stepId === "paket") {
      const checked = document.querySelector<HTMLInputElement>('input[name="paket"]:checked');
      if (!checked) { showFieldError("paket", "Bitte wähle ein Paket aus."); return; }
    }
    if (stepId === "ankauf-felder") {
      const fahrzeug = (document.getElementById("fahrzeug-ank") as HTMLInputElement).value.trim();
      if (!fahrzeug) { showFieldError("fahrzeug_ankauf", "Bitte gib Marke und Modell deines Fahrzeugs an."); return; }
    }
    if (stepId === "kontaktdaten") {
      form.requestSubmit();
      return;
    }

    goToIndex(currentIndex + 1);
  }
  nextBtns.forEach((btn) => btn.addEventListener("click", attemptAdvance));

  document.querySelectorAll<HTMLButtonElement>("[data-wizard-back]").forEach((btn) => {
    btn.addEventListener("click", () => {
      clearErrors();
      goToIndex(Math.max(0, currentIndex - 1));
    });
  });

  render();

  // Pre-fill from query params, e.g. /kontakt?tab=aufbereitung&paket=...&quelle=/ratgeber/...
  const params = new URLSearchParams(location.search);
  const wantedTab = params.get("tab");
  if (wantedTab && STEP_SEQUENCES[wantedTab]) {
    const radio = document.querySelector<HTMLInputElement>(`input[name="dienstleistung"][value="${wantedTab}"]`);
    if (radio) {
      radio.checked = true;
      selectedTab.value = radio.dataset.anliegen ?? "Aufbereitung";
    }
    setPath(wantedTab, true);

    if (wantedTab === "aufbereitung") {
      const wantedPaket = params.get("paket");
      if (wantedPaket) {
        const paketRadio = document.querySelector<HTMLInputElement>(`input[name="paket"][value="${wantedPaket}"]`);
        if (paketRadio) {
          paketRadio.checked = true;
          leistungField.value = paketRadio.dataset.leistung ?? "";
          if (paketRadio.dataset.leistung) showPaketGroupFor(paketRadio.dataset.leistung);
          updateZusatzleistungenAvailability();
          updateVoraussetzungen();
          updateStickyBar();
        }
      }
    }
  }

  const quelle = params.get("quelle");
  if (quelle) {
    (document.getElementById("quelle-field") as HTMLInputElement).value = quelle;
  }

  // Form submit + validation
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const generalError = document.getElementById("form-general-error")!;
  const generalErrorText = document.getElementById("form-general-error-text")!;

  const ERROR_INPUT_CLASSES = ["border-red-400", "focus:ring-red-200"];

  function clearErrors() {
    form.querySelectorAll<HTMLElement>(".field-error").forEach((el) => {
      el.classList.add("hidden");
      el.textContent = "";
    });
    form.querySelectorAll<HTMLElement>("input, select, textarea").forEach((el) => {
      el.classList.remove(...ERROR_INPUT_CLASSES);
    });
    generalError.classList.add("hidden");
  }

  function showFieldError(field: string, message: string) {
    const errorEl = document.getElementById(`error-${field}`);
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove("hidden");
    }
    form.querySelectorAll<HTMLElement>(`[name="${field}"]`).forEach((el) => {
      el.classList.add(...ERROR_INPUT_CLASSES);
    });
  }

  function showGeneralError(message: string) {
    generalErrorText.textContent = message;
    generalError.classList.remove("hidden");
    generalError.scrollIntoView({ behavior: "smooth", block: "center" });
  }

  function validateClientSide(path: string, data: FormData): Record<string, string> {
    const errors: Record<string, string> = {};
    const name = (data.get("name") as string || "").trim();
    const telefon = (data.get("telefon") as string || "").trim();
    const email = (data.get("email") as string || "").trim();

    if (!name) errors.name = "Bitte gib deinen Namen an.";
    if (!telefon) errors.telefon = "Bitte gib deine Telefonnummer an.";
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      errors.email = "Bitte gib eine gültige E-Mail-Adresse an.";
    }

    if (path === "aufbereitung") {
      const plz = (data.get("plz") as string || "").trim();
      if (!plz) errors.plz = "Bitte gib deine Postleitzahl an.";
      else if (!/^\d{5}$/.test(plz)) errors.plz = "Bitte gib eine gültige 5-stellige Postleitzahl an.";

      const paket = (data.get("paket") as string || "").trim();
      if (!paket) errors.paket = "Bitte wähle ein Paket aus.";

      const { showStrom, showWasser } = getVoraussetzungState();
      if (showStrom && data.get("steckdose_verfuegbar") !== "Ja") {
        errors.steckdose_verfuegbar = "Bitte bestätige, dass eine Steckdose vor Ort verfügbar ist.";
      }
      if (showWasser && data.get("wasseranschluss_verfuegbar") !== "Ja") {
        errors.wasseranschluss_verfuegbar = "Bitte bestätige, dass ein Wasseranschluss vor Ort verfügbar ist.";
      }
    } else if (path === "ankauf") {
      const fahrzeug = (data.get("fahrzeug_ankauf") as string || "").trim();
      if (!fahrzeug) errors.fahrzeug_ankauf = "Bitte gib Marke und Modell deines Fahrzeugs an.";
    }

    return errors;
  }

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearErrors();

    const formData = new FormData(form);
    const errors = validateClientSide(currentPath, formData);

    if (Object.keys(errors).length > 0) {
      Object.entries(errors).forEach(([field, message]) => showFieldError(field, message));
      const firstField = Object.keys(errors)[0];
      document.getElementById(`error-${firstField}`)?.scrollIntoView({ behavior: "smooth", block: "center" });
      return;
    }

    const payload: Record<string, unknown> = Object.fromEntries(formData.entries());
    payload.zusatzleistung = formData.getAll("zusatzleistung").filter(Boolean).join(", ");

    const originalText = stickyNextText.textContent;
    nextBtns.forEach((btn) => {
      btn.disabled = true;
      btn.classList.add("opacity-70", "cursor-not-allowed");
      const textEl = btn.querySelector<HTMLElement>(".wizard-next-btn-text");
      if (textEl) textEl.textContent = "Wird gesendet...";
    });

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const result = await res.json();

      if (res.ok && result.success) {
        const name = (payload.name as string || "").split(" ")[0];
        const successText = document.getElementById("form-success-text")!;
        successText.textContent = name
          ? `Vielen Dank, ${name}! Wir haben deine Anfrage erhalten und melden uns so schnell wie möglich bei dir.`
          : "Vielen Dank! Wir haben deine Anfrage erhalten und melden uns so schnell wie möglich bei dir.";
        form.classList.add("hidden");
        wizardProgress.classList.add("hidden");
        stickyBar.classList.add("hidden");
        document.getElementById("form-success")!.classList.remove("hidden");
      } else if (result.errors) {
        let hasFieldError = false;
        Object.entries(result.errors as Record<string, string>).forEach(([field, message]) => {
          if (field === "_general") {
            showGeneralError(message);
          } else {
            showFieldError(field, message);
            hasFieldError = true;
          }
        });
        if (hasFieldError) {
          const firstField = Object.keys(result.errors).find((f) => f !== "_general");
          if (firstField) document.getElementById(`error-${firstField}`)?.scrollIntoView({ behavior: "smooth", block: "center" });
        }
      } else {
        showGeneralError("Es ist ein unerwarteter Fehler aufgetreten. Bitte versuche es erneut.");
      }
    } catch {
      showGeneralError("Die Anfrage konnte nicht gesendet werden. Bitte prüfe deine Internetverbindung und versuche es erneut.");
    } finally {
      nextBtns.forEach((btn) => {
        btn.disabled = !canAdvance();
        btn.classList.remove("opacity-70", "cursor-not-allowed");
        const textEl = btn.querySelector<HTMLElement>(".wizard-next-btn-text");
        if (textEl) textEl.textContent = originalText;
      });
    }
  });
</script>
