---
import Icons from "../Icons.astro";

interface Props {
  id?: string;
  title?: string;
  description?: string;
}
const {
  id = "kontakt",
  title = "Unverbindlich anfragen",
  description = "Sie haben Fragen oder möchten direkt einen Termin? Wir melden uns so schnell es geht.",
} = Astro.props;

const uid = Math.random().toString(36).slice(2, 8);
const source = Astro.url.pathname;
---

<section id={id} class="reveal not-prose my-12 scroll-mt-24">
  <div class="bg-white rounded-3xl border border-gray-100 shadow-xl p-6 md:p-10">
    <div class="text-center mb-8">
      <span class="inline-block bg-[#EEF3FB] text-[#1B2B6B] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-widest uppercase">Kontakt</span>
      <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-2">{title}</h2>
      <p class="text-gray-500 max-w-md mx-auto">{description}</p>
    </div>

    <form id={`cta-form-${uid}`} novalidate class="max-w-xl mx-auto">
      <input type="hidden" name="anliegen" value="Ratgeber-Anfrage" />
      <input type="hidden" name="quelle" value={source} />

      <div id={`cta-general-error-${uid}`} class="hidden mb-5 flex items-start gap-3 rounded-2xl bg-red-50 border border-red-200 p-4">
        <Icons name="exclamation-triangle" class="w-5 h-5 text-red-500 flex-shrink-0 mt-0.5" />
        <p class="cta-general-error-text text-sm text-red-700 leading-relaxed">Es ist ein Fehler aufgetreten.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 mb-5">
        <div>
          <label for={`name-${uid}`} class="block text-sm font-medium text-gray-700 mb-1.5">Name *</label>
          <input type="text" id={`name-${uid}`} name="name" placeholder="Max Mustermann"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
          <p class="cta-error hidden text-xs text-red-600 mt-1.5 font-medium" data-field="name"></p>
        </div>
        <div>
          <label for={`telefon-${uid}`} class="block text-sm font-medium text-gray-700 mb-1.5">Telefon *</label>
          <input type="tel" id={`telefon-${uid}`} name="telefon" placeholder="+49 621 XXXXXXX"
            class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
          <p class="cta-error hidden text-xs text-red-600 mt-1.5 font-medium" data-field="telefon"></p>
        </div>
      </div>

      <div class="mb-5">
        <label for={`email-${uid}`} class="block text-sm font-medium text-gray-700 mb-1.5">E-Mail <span class="font-normal text-gray-400">(optional)</span></label>
        <input type="email" id={`email-${uid}`} name="email" placeholder="max@beispiel.de"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
        <p class="cta-error hidden text-xs text-red-600 mt-1.5 font-medium" data-field="email"></p>
      </div>

      <div class="mb-5">
        <label for={`fahrzeug-${uid}`} class="block text-sm font-medium text-gray-700 mb-1.5">Fahrzeug <span class="font-normal text-gray-400">(optional)</span></label>
        <input type="text" id={`fahrzeug-${uid}`} name="fahrzeug" placeholder="z. B. VW Golf 8"
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm" />
      </div>

      <div class="mb-5">
        <label for={`nachricht-${uid}`} class="block text-sm font-medium text-gray-700 mb-1.5">Nachricht <span class="font-normal text-gray-400">(optional)</span></label>
        <textarea id={`nachricht-${uid}`} name="nachricht" rows="3" placeholder="Ihr Anliegen..."
          class="w-full border border-gray-200 rounded-xl px-4 py-3 text-gray-900 placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-[#3A7BD5] focus:border-transparent transition text-sm resize-none"></textarea>
      </div>

      <div class="mb-6">
        <label class="flex items-start gap-2.5 cursor-pointer">
          <input type="checkbox" name="dsgvo" class="mt-0.5 w-4 h-4 rounded border-gray-300 accent-[#3A7BD5] flex-shrink-0" />
          <span class="text-xs text-gray-500 leading-relaxed">
            Ich stimme zu, dass meine Angaben zur Bearbeitung meiner Anfrage gespeichert werden. Weitere Infos in der
            <a href="/datenschutz" class="text-[#1B2B6B] hover:underline">Datenschutzerklärung</a>. *
          </span>
        </label>
        <p class="cta-error hidden text-xs text-red-600 mt-1.5 font-medium" data-field="dsgvo"></p>
      </div>

      <button type="submit" class="cta-submit btn-primary w-full justify-center text-base">
        <span class="cta-submit-text">Anfrage absenden →</span>
      </button>
    </form>

    <div class="cta-success hidden text-center py-10 px-4 rounded-2xl bg-green-50 border border-green-200 max-w-xl mx-auto">
      <div class="w-14 h-14 rounded-full bg-green-100 flex items-center justify-center mx-auto mb-5">
        <svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
        </svg>
      </div>
      <h3 class="text-xl font-bold text-gray-900 mb-2">Anfrage erhalten!</h3>
      <p class="text-gray-600 text-sm max-w-sm mx-auto">Vielen Dank! Wir melden uns so schnell wie möglich bei Ihnen.</p>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>('form[id^="cta-form-"]').forEach((form) => {
    if (form.dataset.bound) return;
    form.dataset.bound = "true";

    const wrapper = form.closest("section")!;
    const generalError = wrapper.querySelector<HTMLElement>('[id^="cta-general-error-"]')!;
    const generalErrorText = generalError.querySelector<HTMLElement>(".cta-general-error-text")!;
    const submitBtn = form.querySelector<HTMLButtonElement>(".cta-submit")!;
    const submitBtnText = form.querySelector<HTMLElement>(".cta-submit-text")!;

    function clearErrors() {
      form.querySelectorAll<HTMLElement>(".cta-error").forEach((el) => { el.classList.add("hidden"); el.textContent = ""; });
      form.querySelectorAll<HTMLElement>("input, textarea").forEach((el) => el.classList.remove("border-red-400"));
      generalError.classList.add("hidden");
    }

    function showFieldError(field: string, message: string) {
      const errorEl = form.querySelector<HTMLElement>(`.cta-error[data-field="${field}"]`);
      if (errorEl) { errorEl.textContent = message; errorEl.classList.remove("hidden"); }
      form.querySelectorAll<HTMLElement>(`[name="${field}"]`).forEach((el) => el.classList.add("border-red-400"));
    }

    function validateClientSide(data: FormData): Record<string, string> {
      const errors: Record<string, string> = {};
      const name = (data.get("name") as string || "").trim();
      const telefon = (data.get("telefon") as string || "").trim();
      const email = (data.get("email") as string || "").trim();
      if (!name) errors.name = "Bitte gib deinen Namen an.";
      if (!telefon) errors.telefon = "Bitte gib deine Telefonnummer an.";
      if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) errors.email = "Bitte gib eine gültige E-Mail-Adresse an.";
      if (!data.get("dsgvo")) errors.dsgvo = "Bitte stimme der Datenschutzerklärung zu.";
      return errors;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      clearErrors();

      const formData = new FormData(form);
      const errors = validateClientSide(formData);
      if (Object.keys(errors).length > 0) {
        Object.entries(errors).forEach(([field, message]) => showFieldError(field, message));
        return;
      }

      const payload: Record<string, unknown> = Object.fromEntries(formData.entries());
      payload.dsgvo = formData.get("dsgvo") === "on";

      submitBtn.disabled = true;
      submitBtn.classList.add("opacity-70", "cursor-not-allowed");
      const originalText = submitBtnText.textContent;
      submitBtnText.textContent = "Wird gesendet...";

      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload),
        });
        const result = await res.json();

        if (res.ok && result.success) {
          form.classList.add("hidden");
          wrapper.querySelector(".cta-success")!.classList.remove("hidden");
        } else if (result.errors) {
          Object.entries(result.errors as Record<string, string>).forEach(([field, message]) => {
            if (field === "_general") {
              generalErrorText.textContent = message;
              generalError.classList.remove("hidden");
            } else {
              showFieldError(field, message);
            }
          });
        } else {
          generalErrorText.textContent = "Es ist ein unerwarteter Fehler aufgetreten. Bitte versuche es erneut.";
          generalError.classList.remove("hidden");
        }
      } catch {
        generalErrorText.textContent = "Die Anfrage konnte nicht gesendet werden. Bitte prüfe deine Internetverbindung.";
        generalError.classList.remove("hidden");
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove("opacity-70", "cursor-not-allowed");
        submitBtnText.textContent = originalText;
      }
    });
  });
</script>
