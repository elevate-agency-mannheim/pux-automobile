---
import Icons from "../Icons.astro";

interface RelatedItem {
  title: string;
  url: string;
  category: string;
  excerpt?: string;
}
interface Props {
  items: RelatedItem[];
  title?: string;
}
const { items, title = "Das könnte Sie auch interessieren" } = Astro.props;
---

{items.length > 0 && (
  <section class="not-prose my-12 reveal">
    <h2 class="text-2xl font-bold text-gray-900 mb-6">{title}</h2>
    <div class="reveal stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {items.slice(0, 6).map((item) => (
        <a href={item.url} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 p-5 flex flex-col">
          <span class="inline-block w-fit bg-[#EEF3FB] text-[#1B2B6B] text-[11px] font-bold px-2.5 py-1 rounded-full mb-3 tracking-wide uppercase">
            {item.category}
          </span>
          <h3 class="font-bold text-gray-900 leading-snug mb-2 group-hover:text-[#1B2B6B] transition-colors">
            {item.title}
          </h3>
          {item.excerpt && <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-3">{item.excerpt}</p>}
          <span class="mt-auto flex items-center gap-1.5 text-sm font-semibold text-[#3A7BD5]">
            Weiterlesen
            <Icons name="arrow-right" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </section>
)}
