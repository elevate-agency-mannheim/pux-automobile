---
interface Step {
  titel: string;
  beschreibung: string;
}
interface Props {
  steps: Step[];
  title?: string;
}
const { steps, title } = Astro.props;
---

<div class="reveal not-prose my-10">
  {title && <h2 class="text-2xl md:text-3xl font-bold text-gray-900 mb-6">{title}</h2>}
  <ol class="space-y-6">
    {steps.map((step, i) => (
      <li class="flex gap-4 md:gap-5">
        <div class="flex-shrink-0 w-10 h-10 md:w-11 md:h-11 rounded-full flex items-center justify-center text-white font-bold text-sm md:text-base" style="background:linear-gradient(135deg,#1B2B6B,#3A7BD5);">
          {i + 1}
        </div>
        <div class="pt-1.5">
          <h3 class="font-bold text-gray-900 mb-1.5">{step.titel}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{step.beschreibung}</p>
        </div>
      </li>
    ))}
  </ol>
</div>
