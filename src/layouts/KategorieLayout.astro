---
import RatgeberLayout from "./RatgeberLayout.astro";
import CTAButton from "../components/ratgeber/CTAButton.astro";
import LocalCitiesWidget from "../components/ratgeber/LocalCitiesWidget.astro";
import ContactCTA from "../components/ratgeber/ContactCTA.astro";
import Icons from "../components/Icons.astro";

interface Crumb {
  label: string;
  href?: string;
}
interface ArticleItem {
  title: string;
  url: string;
  excerpt?: string;
  badge?: string;
}
interface Subcategory {
  name: string;
  url: string;
  description?: string;
}
interface Props {
  seoTitle: string;
  metaDescription: string;
  canonical?: string;
  breadcrumbs: Crumb[];
  eyebrow: string;
  title: string;
  intro: string;
  subcategories?: Subcategory[];
  articles: ArticleItem[];
  articlesHeading?: string;
  showLocalSection?: boolean;
}
const {
  seoTitle,
  metaDescription,
  canonical,
  breadcrumbs,
  eyebrow,
  title,
  intro,
  subcategories = [],
  articles,
  articlesHeading = "Alle Artikel",
  showLocalSection = true,
} = Astro.props;
---

<RatgeberLayout title={seoTitle} description={metaDescription} canonical={canonical} breadcrumbs={breadcrumbs} containerClass="max-w-6xl">
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-14 reveal">
      <span class="inline-block bg-[#EEF3FB] text-[#1B2B6B] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-widest uppercase">{eyebrow}</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-5 tracking-tight">{title}</h1>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto leading-relaxed">{intro}</p>
      <div class="mt-8 flex justify-center">
        <CTAButton />
      </div>
    </div>

    {subcategories.length > 0 && (
      <div class="reveal stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
        {subcategories.map((sub) => (
          <a href={sub.url} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 p-6">
            <h3 class="font-bold text-gray-900 mb-1.5 group-hover:text-[#1B2B6B] transition-colors">{sub.name}</h3>
            {sub.description && <p class="text-sm text-gray-500 leading-relaxed">{sub.description}</p>}
            <span class="mt-3 flex items-center gap-1.5 text-sm font-semibold text-[#3A7BD5]">
              Mehr erfahren
              <Icons name="arrow-right" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
            </span>
          </a>
        ))}
      </div>
    )}

    <h2 class="text-2xl font-bold text-gray-900 mb-6 reveal">{articlesHeading}</h2>
    <div class="reveal stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
      {articles.map((a) => (
        <a href={a.url} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 p-5 flex flex-col">
          {a.badge && (
            <span class="inline-block w-fit bg-[#EEF3FB] text-[#1B2B6B] text-[11px] font-bold px-2.5 py-1 rounded-full mb-3 tracking-wide uppercase">
              {a.badge}
            </span>
          )}
          <h3 class="font-bold text-gray-900 leading-snug mb-2 group-hover:text-[#1B2B6B] transition-colors">{a.title}</h3>
          {a.excerpt && <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-3">{a.excerpt}</p>}
          <span class="mt-auto flex items-center gap-1.5 text-sm font-semibold text-[#3A7BD5]">
            Weiterlesen
            <Icons name="arrow-right" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>

    {showLocalSection && <div class="reveal"><LocalCitiesWidget /></div>}

    <ContactCTA />
  </div>
</RatgeberLayout>
