<script>
  document.querySelectorAll<HTMLAnchorElement>("a[data-tab]").forEach((link) => {
    link.addEventListener("click", () => {
      const btn = document.querySelector<HTMLButtonElement>(`.tab-btn[data-tab="${link.dataset.tab}"]`);
      if (btn) setTimeout(() => btn.click(), 400);
    });
  });

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // FAQ accordion
  document.querySelectorAll<HTMLElement>(".faq-item").forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>(".faq-trigger")!;
    const panel = item.querySelector<HTMLElement>(".faq-panel")!;
    trigger.addEventListener("click", () => {
      const open = trigger.getAttribute("aria-expanded") === "true";
      trigger.setAttribute("aria-expanded", String(!open));
      panel.style.gridTemplateRows = open ? "0fr" : "1fr";
    });
  });

  // Cursor spotlight glow for ".spotlight" cards
  document.querySelectorAll<HTMLElement>(".spotlight").forEach((card) => {
    card.addEventListener("pointermove", (e) => {
      const rect = card.getBoundingClientRect();
      card.style.setProperty("--mx", `${e.clientX - rect.left}px`);
      card.style.setProperty("--my", `${e.clientY - rect.top}px`);
    });
  });

  // Animated price count-up when a package card scrolls into view
  const priceEls = document.querySelectorAll<HTMLElement>(".price-counter");
  const priceObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const el = entry.target as HTMLElement;
        const target = Number(el.dataset.target ?? "0");
        priceObserver.unobserve(el);

        if (reduceMotion) { el.textContent = String(target); return; }

        const duration = 900;
        const start = performance.now();
        function tick(now: number) {
          const progress = Math.min((now - start) / duration, 1);
          const eased = 1 - Math.pow(1 - progress, 3);
          el.textContent = String(Math.round(target * eased));
          if (progress < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      });
    },
    { threshold: 0.4 }
  );
  priceEls.forEach((el) => priceObserver.observe(el));
</script>
