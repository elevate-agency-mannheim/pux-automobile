  <script>
    (function () {
      const track = document.querySelector<HTMLElement>("[data-gallery-track]");
      if (!track) return;
      const cards = Array.from(track.querySelectorAll<HTMLElement>("[data-gallery-card]"));
      const isDesktop = () => window.matchMedia("(min-width: 768px)").matches;

      // Only one video ever plays at a time.
      const playVideo = (index: number) => {
        cards.forEach((c, i) => {
          const video = c.querySelector("video");
          if (!video) return;
          if (i === index) {
            c.classList.add("is-active");
            c.dataset.playing = "true";
            video.play().catch(() => {});
          } else {
            c.classList.remove("is-active");
            c.dataset.playing = "false";
            video.pause();
          }
        });
      };

      const pauseVideo = (index: number) => {
        const card = cards[index];
        const video = card?.querySelector("video");
        if (!card || !video) return;
        video.pause();
        card.dataset.playing = "false";
      };

      // Clicking/tapping a card toggles play/pause; clicking a different
      // card switches to it (and pauses whatever was playing before).
      cards.forEach((card, index) => {
        card.addEventListener("click", () => {
          const isPlaying = card.dataset.playing === "true";
          if (isPlaying) {
            pauseVideo(index);
          } else {
            playVideo(index);
          }
        });

        const video = card.querySelector("video");
        video?.addEventListener("ended", () => {
          if (isDesktop()) {
            // Desktop: auto-advance through the set, one video after another.
            const next = (index + 1) % cards.length;
            playVideo(next);
            cards[next]?.scrollIntoView({ behavior: "smooth", inline: "start", block: "nearest" });
          } else {
            // Mobile: stay on the swiped-to video, just loop it.
            video.currentTime = 0;
            video.play().catch(() => {});
          }
        });
      });

      // Scrolling/swiping to a card (mobile swipe, or desktop arrow buttons)
      // makes that one the active, playing video.
      const observer = new IntersectionObserver(
        (entries) => {
          const mostVisible = entries
            .filter((e) => e.isIntersecting)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (mostVisible) {
            const idx = cards.indexOf(mostVisible.target as HTMLElement);
            if (idx !== -1) playVideo(idx);
          }
        },
        { root: track, threshold: [0.5, 0.6, 0.7, 0.8, 0.9] }
      );
      cards.forEach((c) => observer.observe(c));

      track.querySelectorAll<HTMLButtonElement>("[data-gallery-mute]").forEach((btn) => {
        btn.addEventListener("click", (e) => {
          e.stopPropagation();
          const card = btn.closest<HTMLElement>("[data-gallery-card]");
          const video = card?.querySelector("video");
          if (!video) return;
          video.muted = !video.muted;
          btn.dataset.muted = String(video.muted);
          btn.setAttribute("aria-pressed", String(!video.muted));
        });
      });

      const scrollByCard = (dir: 1 | -1) => {
        const card = cards[0];
        if (!card) return;
        const amount = card.getBoundingClientRect().width + 20;
        track.scrollBy({ left: dir * amount, behavior: "smooth" });
      };
      document.querySelector("[data-gallery-prev]")?.addEventListener("click", () => scrollByCard(-1));
      document.querySelector("[data-gallery-next]")?.addEventListener("click", () => scrollByCard(1));
    })();
  </script>

