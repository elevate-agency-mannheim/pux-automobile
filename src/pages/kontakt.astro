---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import ContactForm from "../components/ContactForm.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Kontakt | PUX Automobile – Mobile Autoaufbereitung & An-/Verkauf"
  description="Unverbindlich anfragen: Autoaufbereitung, Fahrzeugankauf oder -verkauf im Raum Mannheim. Wir melden uns innerhalb von 24 Stunden."
  canonical="https://pux-automobile.de/kontakt"
>
  <Nav />

  <section class="relative pt-32 pb-24 px-6 bg-gray-50">
    <div class="max-w-3xl mx-auto">
      <div class="text-center mb-12 reveal">
        <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-5 tracking-tight">Unverbindlich anfragen</h1>
        <p class="text-gray-500 text-sm sm:text-lg whitespace-nowrap">
          Wählen Sie Ihr Anliegen – wir melden uns <strong class="text-gray-700 font-semibold">innerhalb von 24 Stunden</strong> bei Ihnen.
        </p>
      </div>
      <div class="reveal" style="transition-delay:0.1s">
        <ContactForm />
      </div>
    </div>
  </section>

  <Footer />
</Layout>
