---
import { getCollection } from "astro:content";
import RatgeberLayout from "../../layouts/RatgeberLayout.astro";
import CTAButton from "../../components/ratgeber/CTAButton.astro";
import Icons from "../../components/Icons.astro";
import type { IconName } from "../../components/Icons.astro";

const allEntries = await getCollection("ratgeber");

const CATEGORIES: { slug: string; name: string; description: string; icon: IconName }[] = [
  { slug: "autoaufbereitung", name: "Autoaufbereitung", description: "Politur, Lackpflege, Innen- & Außenreinigung.", icon: "sparkles" },
  { slug: "fahrzeugverkauf", name: "Auto verkaufen", description: "Ablauf, Bewertung, Unterlagen – schnell & fair.", icon: "banknote" },
  { slug: "fahrzeugankauf", name: "Gebrauchtwagen kaufen", description: "Checklisten & Kaufberatung.", icon: "car" },
  { slug: "wissen", name: "Ratgeber & Wissen", description: "Pflegetipps, Vergleiche und Antworten auf häufige Fragen.", icon: "academic-cap" },
];

const categoriesWithCounts = CATEGORIES.map((c) => ({
  ...c,
  count: allEntries.filter((e) => e.data.category === c.slug).length,
}));

const standorte = allEntries.filter((e) => e.data.category === "standorte");
const featured = allEntries.filter((e) => e.data.category !== "standorte").slice(0, 6);

const CATEGORY_LABELS: Record<string, string> = {
  autoaufbereitung: "Autoaufbereitung",
  fahrzeugverkauf: "Auto verkaufen",
  fahrzeugankauf: "Gebrauchtwagen kaufen",
  wissen: "Wissen",
};
---

<RatgeberLayout
  title="Ratgeber | PUX Automobile Mannheim"
  description="Praxisnahe Ratgeber zu Autoaufbereitung, Fahrzeugankauf und -verkauf im Raum Mannheim – Tipps, Kosten-Guides und Checklisten von PUX Automobile."
  canonical="https://pux-automobile.de/ratgeber"
  containerClass="max-w-6xl"
  breadcrumbs={[{ label: "Startseite", href: "/" }, { label: "Ratgeber" }]}
>
  <div class="max-w-6xl mx-auto">
    <div class="text-center mb-16 reveal">
      <span class="inline-block bg-[#EEF3FB] text-[#1B2B6B] text-xs font-bold px-4 py-1.5 rounded-full mb-4 tracking-widest uppercase">Ratgeber</span>
      <h1 class="text-3xl md:text-4xl lg:text-5xl font-extrabold text-gray-900 mb-5 tracking-tight">
        Wissen rund um Ihr Fahrzeug
      </h1>
      <p class="text-gray-500 text-lg max-w-2xl mx-auto leading-relaxed">
        Praxisnahe Antworten zu Autoaufbereitung, Fahrzeugankauf und -verkauf im Raum Mannheim.
      </p>
      <div class="mt-8 flex justify-center">
        <CTAButton />
      </div>
    </div>

    <div class="reveal stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-16">
      {categoriesWithCounts.map((cat) => (
        <a href={`/ratgeber/${cat.slug}`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 p-6 flex flex-col">
          <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-4 text-white flex-shrink-0" style="background:linear-gradient(135deg,#1B2B6B,#3A7BD5);">
            <Icons name={cat.icon} class="w-5.5 h-5.5" />
          </div>
          <h2 class="font-bold text-gray-900 mb-1.5 group-hover:text-[#1B2B6B] transition-colors">{cat.name}</h2>
          <p class="text-sm text-gray-500 leading-relaxed mb-3">{cat.description}</p>
          <span class="mt-auto text-xs font-semibold text-gray-400">{cat.count} {cat.count === 1 ? "Artikel" : "Artikel"}</span>
        </a>
      ))}
    </div>

    {featured.length > 0 && (
      <>
        <h2 class="text-2xl font-bold text-gray-900 mb-6 reveal">Neueste Artikel</h2>
        <div class="reveal stagger grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-16">
          {featured.map((a) => (
            <a href={`/ratgeber/${a.data.category}/${a.data.slug}`} class="group bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300 p-5 flex flex-col">
              <span class="inline-block w-fit bg-[#EEF3FB] text-[#1B2B6B] text-[11px] font-bold px-2.5 py-1 rounded-full mb-3 tracking-wide uppercase">
                {CATEGORY_LABELS[a.data.category]}
              </span>
              <h3 class="font-bold text-gray-900 leading-snug mb-2 group-hover:text-[#1B2B6B] transition-colors">{a.data.title}</h3>
              <p class="text-xs text-gray-500 leading-relaxed line-clamp-2 mb-3">{a.data.metaDescription}</p>
              <span class="mt-auto flex items-center gap-1.5 text-sm font-semibold text-[#3A7BD5]">
                Weiterlesen
                <Icons name="arrow-right" class="w-3.5 h-3.5 transition-transform duration-300 group-hover:translate-x-1" />
              </span>
            </a>
          ))}
        </div>
      </>
    )}

    {standorte.length > 0 && (
      <div class="reveal rounded-2xl border border-gray-100 bg-[#EEF3FB]/50 p-6 md:p-8">
        <h2 class="flex items-center gap-2 font-bold text-gray-900 mb-4">
          <Icons name="map-pin" class="w-5 h-5 text-[#3A7BD5]" />
          Unsere Standorte
        </h2>
        <div class="flex flex-wrap gap-2.5">
          {standorte.map((s) => (
            <a href={`/ratgeber/standorte/${s.data.slug}`}
              class="inline-flex items-center gap-1.5 bg-white border border-gray-200 rounded-full px-4 py-2 text-sm font-medium text-gray-700 hover:border-[#3A7BD5] hover:text-[#1B2B6B] transition-colors">
              {s.data.targetCities[0]}
            </a>
          ))}
        </div>
      </div>
    )}

    <div class="reveal not-prose my-12 flex justify-center">
      <CTAButton text="Jetzt unverbindlich anfragen" />
    </div>
  </div>
</RatgeberLayout>
